# Akhana Admin - variables de producción (specs/deploy.md).
# Copiar a /opt/akhana/.env en el VPS (root, chmod 600) y completar con secretos NUEVOS; nunca los de desarrollo.
# Guardar una copia de este archivo completo en el gestor de contraseñas del dueño.

# Base de datos
DB_NAME=akhana
DB_USERNAME=akhana
# openssl rand -hex 24
DB_PASSWORD=

# Firma de los JWT (32+ caracteres): openssl rand -hex 32
JWT_SECRET=
# Expiración de la sesión (NF-02): 12h = un turno completo
JWT_EXPIRATION=12h

# Primer administrador: solo se crea con la base vacía y debe cambiar la contraseña al entrar (USR-06)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Zona horaria del backend (fechas de la tienda)
TZ=America/La_Paz

# Puerto local de nginx; `tailscale serve` le pone HTTPS delante
WEB_PORT=8081

# Respaldo (NF-01): remoto cifrado de rclone fuera de Contabo (`rclone config`: b2 + crypt)
BACKUP_REMOTE=akhana-crypt:
BACKUP_DIR=/var/backups/akhana
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=60

# Avisos de healthchecks.io (uno por chequeo); vacío = sin aviso
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_RESTORE_URL=
# Despliegue continuo (NF-06): aviso cada 2 minutos; en rojo si el último despliegue falló
HEALTHCHECK_DEPLOY_URL=
