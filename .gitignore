# --- Operating System & General ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp

# --- IDE & Editors ---
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
.factorypath
bin/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Backend: Spring Boot / Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
out/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Frontend: Angular / Node ---
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
