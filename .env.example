# Akhana Admin - variables de entorno para desarrollo local.
# Copiar a .env (no se versiona): docker compose lo lee solo y el backend lo importa al arrancar.
# En producción, definir estas variables en el servidor con valores propios; nunca reutilizar estos.

# Base de datos (docker compose usa DB_NAME/DB_USERNAME/DB_PASSWORD al crear el contenedor)
DB_NAME=akhana
DB_USERNAME=akhana
DB_PASSWORD=change-me-local-db-password
DB_URL=jdbc:postgresql://localhost:5432/akhana

# Secreto para firmar los JWT: al menos 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
# Duración del token en milisegundos (24 h)
JWT_EXPIRATION=86400000

# Primer administrador: solo se crea si la base no tiene usuarios, y debe cambiar la contraseña al ingresar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
